SILICONFLOW_TIMEOUT_MS=60000
SILICONFLOW_MAX_TOKENS=8192
OPENAI_ENABLED=false
OPENAI_API_KEY=
OPENAI_API_KEY_REF=OPENAI_API_KEY
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=
OPENAI_TIMEOUT_MS=30000
GEMINI_API_KEY=
