{
  "name": "ctd-abpa",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.19.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "pnpm -r build",
    "dev": "pnpm --parallel --filter @ctd-abpa/api --filter @ctd-abpa/web dev",
    "test": "vitest run",
    "test:real-data": "node scripts/test-real-data.mjs",
    "test:e2e": "playwright test",
    "test:model:real": "tsx scripts/validate-real-model.ts",
    "test:watch": "vitest",
    "typecheck": "pnpm -r typecheck",
    "lint": "eslint .",
    "bridge": "tsx apps/cli/src/index.ts",
    "demo": "tsx scripts/run-demo.ts",
    "verify:artifacts": "tsx scripts/verify-artifacts.ts",
    "migrate:tasks": "tsx scripts/migrate-tasks.ts",
    "benchmark:capacity": "tsx scripts/benchmark-capacity.ts"
  },
  "devDependencies": {
    "@playwright/test": "^1.55.0",
    "@types/node": "^24.3.1",
    "@typescript-eslint/eslint-plugin": "^8.42.0",
    "@typescript-eslint/parser": "^8.42.0",
    "eslint": "^9.35.0",
    "fast-check": "^4.3.0",
    "fastify": "^5.12.3",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4",
    "zod": "^4.1.5"
  }
}
